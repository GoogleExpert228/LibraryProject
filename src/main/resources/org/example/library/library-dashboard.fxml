<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="900.0" prefWidth="1300.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.library.controllers.LibraryDashboardController">
    <top>
        <VBox spacing="4.0">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Информационна система „Библиотека“" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Управление на потребители, книги, формуляри, справки и известия според заданията."/>
        </VBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Потребители и формуляри">
                    <BorderPane>
                        <left>
                            <ScrollPane fitToWidth="true">
                                <VBox spacing="12">
                                    <padding>
                                        <Insets top="12" right="12" bottom="12" left="12"/>
                                    </padding>
                                    <TitledPane text="Създаване на оператор" expanded="true">
                                        <content>
                                            <GridPane hgap="8" vgap="8">
                                                <columnConstraints>
                                                    <ColumnConstraints halignment="RIGHT"/>
                                                    <ColumnConstraints hgrow="ALWAYS"/>
                                                </columnConstraints>
                                                <children>
                                                    <Label text="Потребителско име:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                                    <TextField fx:id="operatorUsernameField" promptText="operator" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                                    <Label text="Парола:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                                    <PasswordField fx:id="operatorPasswordField" promptText="••••" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                                    <Label text="Име:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                                    <TextField fx:id="operatorFullNameField" promptText="Име и фамилия" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                                    <Label text="Имейл:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                                    <TextField fx:id="operatorEmailField" promptText="email@library.bg" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                                    <Button text="Създай оператор" onAction="#onCreateOperator" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.halignment="RIGHT"/>
                                                </children>
                                            </GridPane>
                                        </content>
                                    </TitledPane>

                                    <TitledPane text="Регистрация и управление на читатели" expanded="false">
                                        <content>
                                            <VBox spacing="10">
                                                <GridPane hgap="8" vgap="8">
                                                    <columnConstraints>
                                                        <ColumnConstraints halignment="RIGHT"/>
                                                        <ColumnConstraints hgrow="ALWAYS"/>
                                                    </columnConstraints>
                                                    <children>
                                                        <Label text="Потребителско име:" GridPane.rowIndex="0"/>
                                                        <TextField fx:id="readerUsernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                                        <Label text="Парола:" GridPane.rowIndex="1"/>
                                                        <PasswordField fx:id="readerPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                                        <Label text="Име:" GridPane.rowIndex="2"/>
                                                        <TextField fx:id="readerFullNameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                                        <Label text="Имейл:" GridPane.rowIndex="3"/>
                                                        <TextField fx:id="readerEmailField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                                        <Button text="Създай читател" onAction="#onRegisterReader" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.halignment="RIGHT"/>
                                                    </children>
                                                </GridPane>
                                                <Separator/>
                                                <Label text="Отписване и блокиране:"/>
                                                <HBox spacing="8">
                                                    <ComboBox fx:id="readerSelectionBox" promptText="Изберете читател" HBox.hgrow="ALWAYS"/>
                                                    <Button text="Блокирай" onAction="#onDeactivateReader"/>
                                                    <Button text="Отпиши" onAction="#onRemoveReader"/>
                                                </HBox>
                                            </VBox>
                                        </content>
                                    </TitledPane>

                                    <TitledPane text="Формуляри за читателски профил" expanded="false">
                                        <content>
                                            <VBox spacing="10">
                                                <Label text="Съдържание на формуляра:"/>
                                                <TextArea fx:id="formContentArea" promptText="Кратко описание на заявката" prefRowCount="3"/>
                                                <GridPane hgap="8" vgap="8">
                                                    <columnConstraints>
                                                        <ColumnConstraints halignment="RIGHT"/>
                                                        <ColumnConstraints hgrow="ALWAYS"/>
                                                    </columnConstraints>
                                                    <children>
                                                        <Label text="Читател:" GridPane.rowIndex="0"/>
                                                        <ComboBox fx:id="formSubmittedByCombo" promptText="Изберете читател" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                                        <Label text="Оператор:" GridPane.rowIndex="1"/>
                                                        <ComboBox fx:id="formOperatorCombo" promptText="(по избор)" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                                    </children>
                                                </GridPane>
                                                <Button text="Подай формуляр" onAction="#onSubmitForm" GridPane.halignment="RIGHT"/>
                                                <Separator/>
                                                <Label text="Обновяване на статус:"/>
                                                <HBox spacing="8">
                                                    <ComboBox fx:id="formSelectionCombo" promptText="Формуляр" HBox.hgrow="ALWAYS"/>
                                                    <ComboBox fx:id="formStatusCombo" promptText="Статус"/>
                                                    <Button text="Обнови" onAction="#onUpdateFormStatus"/>
                                                </HBox>
                                            </VBox>
                                        </content>
                                    </TitledPane>

                                    <TitledPane text="Рейтинг на читатели" expanded="false">
                                        <content>
                                            <HBox spacing="8">
                                                <ComboBox fx:id="ratingReaderCombo" promptText="Читател" HBox.hgrow="ALWAYS"/>
                                                <ComboBox fx:id="loyaltyLevelCombo" promptText="Рейтинг"/>
                                                <Button text="Запази" onAction="#onUpdateRating"/>
                                            </HBox>
                                        </content>
                                    </TitledPane>
                                </VBox>
                            </ScrollPane>
                        </left>
                        <center>
                            <VBox spacing="12">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>
                                <Label text="Всички потребители"/>
                                <TableView fx:id="usersTable" prefHeight="220">
                                    <columns>
                                        <TableColumn fx:id="userNameColumn" text="Име" prefWidth="200"/>
                                        <TableColumn fx:id="userRoleColumn" text="Роля" prefWidth="120"/>
                                        <TableColumn fx:id="userStatusColumn" text="Статус" prefWidth="120"/>
                                        <TableColumn fx:id="userRegistrationColumn" text="Регистрация" prefWidth="140"/>
                                    </columns>
                                </TableView>
                                <Label text="Подадени формуляри"/>
                                <TableView fx:id="formsTable" prefHeight="220">
                                    <columns>
                                        <TableColumn fx:id="formDateColumn" text="Дата" prefWidth="120"/>
                                        <TableColumn fx:id="formStatusColumn" text="Статус" prefWidth="120"/>
                                        <TableColumn fx:id="formContentColumn" text="Съдържание" prefWidth="360"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </center>
                        <bottom>
                            <Label fx:id="statusLabel" text="Готово">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>
                            </Label>
                        </bottom>
                    </BorderPane>
                </Tab>

                <Tab text="Книги и заемане">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="14">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="12"/>
                            </padding>
                            <TitledPane text="Добавяне на нова книга" expanded="true">
                                <content>
                                    <GridPane hgap="8" vgap="8">
                                        <columnConstraints>
                                            <ColumnConstraints halignment="RIGHT"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <children>
                                            <Label text="Инвентарен №:" GridPane.rowIndex="0"/>
                                            <TextField fx:id="bookInventoryField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                            <Label text="Заглавие:" GridPane.rowIndex="1"/>
                                            <TextField fx:id="bookTitleField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                            <Label text="Автор:" GridPane.rowIndex="2"/>
                                            <TextField fx:id="bookAuthorField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                            <Label text="Жанр:" GridPane.rowIndex="3"/>
                                            <TextField fx:id="bookGenreField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                            <Label text="Състояние:" GridPane.rowIndex="4"/>
                                            <ComboBox fx:id="bookConditionCombo" promptText="GOOD" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                            <Button text="Добави книга" onAction="#onAddBook" GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.halignment="RIGHT"/>
                                        </children>
                                    </GridPane>
                                </content>
                            </TitledPane>

                            <TitledPane text="Архивиране и бракуване" expanded="false">
                                <content>
                                    <GridPane hgap="8" vgap="8">
                                        <columnConstraints>
                                            <ColumnConstraints halignment="RIGHT"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints halignment="RIGHT"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <children>
                                            <Label text="Архивирай:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                            <ComboBox fx:id="archiveBookCombo" promptText="Изберете книга" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                            <Button text="Архивирай" onAction="#onArchiveBook" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                                            <Label text="Бракувай:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                            <ComboBox fx:id="scrapBookCombo" promptText="Изберете книга" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                            <Button text="Бракувай" onAction="#onScrapBook" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                        </children>
                                    </GridPane>
                                </content>
                            </TitledPane>

                            <TitledPane text="Отдаване на книги" expanded="false">
                                <content>
                                    <GridPane hgap="8" vgap="8">
                                        <columnConstraints>
                                            <ColumnConstraints halignment="RIGHT"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <children>
                                            <Label text="Читател:" GridPane.rowIndex="0"/>
                                            <ComboBox fx:id="borrowReaderCombo" promptText="Изберете читател" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                            <Label text="Книга:" GridPane.rowIndex="1"/>
                                            <ComboBox fx:id="borrowBookCombo" promptText="Налични книги" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                            <Label text="Тип заем:" GridPane.rowIndex="2"/>
                                            <ComboBox fx:id="borrowTypeCombo" promptText="Избор" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                            <Label text="Срок за връщане:" GridPane.rowIndex="3"/>
                                            <DatePicker fx:id="borrowDueDatePicker" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                            <Button text="Отдай книга" onAction="#onBorrowBook" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.halignment="RIGHT"/>
                                        </children>
                                    </GridPane>
                                </content>
                            </TitledPane>

                            <TitledPane text="Връщане на книги" expanded="false">
                                <content>
                                    <HBox spacing="8">
                                        <ComboBox fx:id="returnBorrowCombo" promptText="Активни заеми" HBox.hgrow="ALWAYS"/>
                                        <Button text="Маркирай върната" onAction="#onReturnBook"/>
                                    </HBox>
                                </content>
                            </TitledPane>

                            <Label text="Каталог книги"/>
                            <TableView fx:id="booksTable" prefHeight="240">
                                <columns>
                                    <TableColumn fx:id="bookInventoryColumn" text="Инвентарен №" prefWidth="140"/>
                                    <TableColumn fx:id="bookTitleColumn" text="Заглавие" prefWidth="220"/>
                                    <TableColumn fx:id="bookConditionColumn" text="Състояние" prefWidth="120"/>
                                    <TableColumn fx:id="bookAvailabilityColumn" text="Наличност" prefWidth="120"/>
                                </columns>
                            </TableView>

                            <Label text="Заеми"/>
                            <TableView fx:id="borrowsTable" prefHeight="240">
                                <columns>
                                    <TableColumn fx:id="borrowReaderColumn" text="Читател" prefWidth="200"/>
                                    <TableColumn fx:id="borrowBookColumn" text="Книга" prefWidth="220"/>
                                    <TableColumn fx:id="borrowTypeColumn" text="Тип" prefWidth="100"/>
                                    <TableColumn fx:id="borrowDueDateColumn" text="Срок" prefWidth="120"/>
                                    <TableColumn fx:id="borrowStatusColumn" text="Статус" prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <Tab text="Справки">
                    <VBox spacing="12">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="Просрочени заеми"/>
                        <TableView fx:id="overdueTable" prefHeight="250">
                            <columns>
                                <TableColumn fx:id="overdueReaderColumn" text="Читател" prefWidth="220"/>
                                <TableColumn fx:id="overdueBookColumn" text="Книга" prefWidth="220"/>
                                <TableColumn fx:id="overdueDueColumn" text="Срок" prefWidth="140"/>
                                <TableColumn fx:id="overdueStatusColumn" text="Статус" prefWidth="120"/>
                            </columns>
                        </TableView>

                        <Label text="Рейтинг на читатели"/>
                        <TableView fx:id="ratingsTable" prefHeight="220">
                            <columns>
                                <TableColumn fx:id="ratingReaderColumn" text="Читател" prefWidth="240"/>
                                <TableColumn fx:id="ratingLevelColumn" text="Ниво" prefWidth="160"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

                <Tab text="Известия">
                    <BorderPane>
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <left>
                            <VBox spacing="10" prefWidth="360">
                                <Label text="Ново известие"/>
                                <ComboBox fx:id="notificationTypeCombo" promptText="Тип известие"/>
                                <TextArea fx:id="notificationMessageArea" promptText="Съобщение" prefRowCount="4"/>
                                <ComboBox fx:id="notificationRecipientCombo" promptText="Получател (по избор)"/>
                                <Button text="Запази известие" onAction="#onCreateNotification" maxWidth="Infinity"/>
                            </VBox>
                        </left>
                        <center>
                            <VBox spacing="10">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>
                                <Label text="Всички известия"/>
                                <TableView fx:id="notificationsTable" prefHeight="520">
                                    <columns>
                                        <TableColumn fx:id="notificationDateColumn" text="Дата" prefWidth="120"/>
                                        <TableColumn fx:id="notificationTypeTableColumn" text="Тип" prefWidth="160"/>
                                        <TableColumn fx:id="notificationRecipientColumn" text="Получател" prefWidth="200"/>
                                        <TableColumn fx:id="notificationMessageColumn" text="Съобщение" prefWidth="320"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </center>
                    </BorderPane>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>

